# Export these variables in your shell or configure an env_file in your runtime.
HF_TOKEN=
SABER_OWNER_EMAIL=you@example.com
SABER_SECRET_KEY=
# Local HTTP only; hosted deployment must use 1.
SABER_COOKIE_SECURE=0

# Optional prepared public-card artifacts (separate from the application DB).
# Pin an immutable commit for the configured embedding model before preparing.
SABER_EMBEDDING_REVISION=
SABER_EMBEDDING_CACHE=
SABER_CARD_FACTS=
# Choose a local C++ binary OR the private simulator service base URL.
SABER_RESOURCE_PROBE_BIN=
SABER_RESOURCE_PROBE_URL=
SABER_RESOURCE_PROBE_TOKEN=
